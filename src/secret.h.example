// LoRaWAN OTAA (TTN) - Platzhalter (alles Null). Mit eigenen Keys aus der TTN-Konsole ersetzen.
#define LORAWAN_JOIN_EUI "0000000000000000"
#define LORAWAN_DEV_EUI  "0000000000000000"
#define LORAWAN_APP_KEY  "00000000000000000000000000000000"
